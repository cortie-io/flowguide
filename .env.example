# ============================================================
# n9n 통합 환경변수 템플릿
# cp .env.example .env  →  .env 값을 채운 뒤 docker compose up
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=n9n
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chatbot
# Docker 내부 네트워크 주소 (컨테이너끼리 통신)
POSTGRES_URL=postgresql://n9n:changeme@postgres:5432/chatbot

# ── Next.js 인증 ─────────────────────────────────────────────
# 생성: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# ── n9n FastAPI 백엔드 ────────────────────────────────────────
# chatbot → backend 내부 통신 (Docker 네트워크)
N9N_API=http://backend:8000

# ── OpenAI (LLM / Embedding) ─────────────────────────────────
OPENAI_API_KEY=sk-proj-...
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
RERANKER_MODEL=bge-reranker-v2-m3

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ── Vercel 연동 (자체 호스팅 시 비워도 됨) ──────────────────
BLOB_READ_WRITE_TOKEN=
REDIS_URL=
AI_GATEWAY_API_KEY=
