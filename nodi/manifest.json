{
  "manifest_version": 3,
  "name": "Naito",
  "version": "1.0.5",
  "description": "Next-Gen Node Automation Tutor — Naito 인터랙티브 AI 교육 플랫폼",
  "icons": {
    "16": "icons/nodi-icon16.png",
    "48": "icons/nodi-icon48.png",
    "128": "icons/nodi-icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "https://naito.chat/*",
    "https://n8n.cortie.io/*",
    "http://localhost:5678/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Naito Tutor Agent",
    "default_icon": {
      "16": "icons/nodi-icon16.png",
      "48": "icons/nodi-icon48.png",
      "128": "icons/nodi-icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5678/*", "https://n8n.cortie.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://naito.chat/*", "http://localhost:3000/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; frame-src https://naito.chat http://localhost:3000; script-src 'self'; style-src 'self' 'unsafe-inline';"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.js", "sidepanel-capture.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
